APP_ENV=dev
APP_DEBUG=1
# Set a unique random value in .env.local for deployment.
APP_SECRET=change-this-for-production
# Windows PHP connects to the MySQL container through its loopback-only port.
# Put the actual DB_PASSWORD from the private .env file into .env.local.
DATABASE_URL="mysql://solar:solar_local@127.0.0.1:3307/solar_db?charset=utf8mb4"
