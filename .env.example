APP_ENV=dev
APP_DEBUG=1
# Set a unique random value in .env.local for deployment.
APP_SECRET=change-this-for-production
# The app container connects to the MySQL service in compose.yaml.
# Use the same DB_PASSWORD in Compose and in this URL when running commands there.
DATABASE_URL="mysql://solar:solar_local@database:3306/solar_db?charset=utf8mb4"
