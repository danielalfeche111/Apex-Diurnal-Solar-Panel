{
    "name": "apex-diurnal/solar-platform",
    "description": "Apex Diurnal storefront and administration on Symfony",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.7",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "config": {"sort-packages": true, "allow-plugins": {}},
    "scripts": {
        "cache:clear": "@php bin/console cache:clear",
        "test": "@php tests/run.php"
    }
}
